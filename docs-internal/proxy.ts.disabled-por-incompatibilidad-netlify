// disponible, 5.15.12) no logra bundlear esta versión de Next.js 16 como
// edge function ("Bundling of edge function failed / Could not load edge
// function at .../___netlify-edge-handler-node-middleware.js"). Es un
// problema de la herramienta de deploy de Netlify, no del código: los docs
// de Next.js (node_modules/next/dist/docs) confirman que Netlify todavía
// está construyendo su adapter oficial para esta versión.
//
// Mientras tanto, cada página protegida (src/app/mi-cuenta, src/app/catalogo,
// src/app/catalogo/[clase]) hace su propio chequeo de sesión server-side, así
// que el bloqueo de acceso sigue funcionando sin este archivo. Lo que se
// pierde: el refresco automático de la cookie de sesión en cada request, así
// que una sesión inactiva puede vencer un poco antes de lo ideal. No es un
// hueco de seguridad, es peor UX de sesión.
//
// Para reactivar: renombrar este archivo a src/proxy.ts y volver a probar
// `netlify deploy --prod` — si Netlify ya sacó su adapter para Next 16 esto
// debería andar de nuevo.

import { NextResponse, type NextRequest } from "next/server";
import { updateSession } from "@/lib/supabase/session";

// Nota: en esta versión de Next.js el archivo "middleware.ts" se llama
// "proxy.ts" (ver node_modules/next/dist/docs/.../file-conventions/proxy.md).
// Acá refrescamos la sesión de Supabase en cada request y bloqueamos el
// acceso a las rutas privadas si no hay sesión.

const PROTECTED_PREFIXES = ["/catalogo", "/mi-cuenta"];

function isProtectedPath(pathname: string) {
  return PROTECTED_PREFIXES.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
}

export async function proxy(request: NextRequest) {
  const { supabaseResponse, user } = await updateSession(request);

  if (isProtectedPath(request.nextUrl.pathname) && !user) {
    const url = request.nextUrl.clone();
    url.pathname = "/ingresar";
    url.search = "";
    url.searchParams.set("next", request.nextUrl.pathname);
    return NextResponse.redirect(url);
  }

  return supabaseResponse;
}

export const config = {
  matcher: [
    // Corre en todas las rutas menos assets estáticos, para poder refrescar
    // la sesión en cualquier página (así el Header sabe si hay login o no).
    "/((?!_next/static|_next/image|favicon.ico|sw.js|manifest.webmanifest|icons/|logo/|images/).*)",
  ],
};
